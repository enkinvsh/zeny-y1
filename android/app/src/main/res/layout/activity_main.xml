<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <ImageView
        android:id="@+id/iv_main_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="#000000" />

    <LinearLayout
        android:id="@+id/layout_main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingTop="36dp"
        android:visibility="visible"
        android:background="#00000000">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#55000000"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_now_playing" android:layout_width="match_parent" android:layout_height="48dp" android:text="Now Playing" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_play" android:layout_width="match_parent" android:layout_height="48dp" android:text="Music" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_bluetooth" android:layout_width="match_parent" android:layout_height="48dp" android:text="Bluetooth" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_settings" android:layout_width="match_parent" android:layout_height="48dp" android:text="Settings" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_radio" android:layout_width="match_parent" android:layout_height="48dp" android:text="FM Radio" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/btn_webserver" android:layout_width="match_parent" android:layout_height="48dp" android:text="PC Upload" android:textColor="#FFFFFF" android:background="#00000000" android:gravity="left|center_vertical" android:paddingLeft="15dp" android:textSize="18sp" android:focusable="true"/>
                <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:text="〉" android:textColor="#888888" android:gravity="center_vertical" android:layout_gravity="right" android:paddingRight="15dp" android:textSize="16sp" android:focusable="false" android:clickable="false"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#00000000"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <ImageView
                android:id="@+id/iv_menu_preview"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_media_play"/>

            <TextView
                android:id="@+id/tv_menu_preview_title"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_menu_preview_artist"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_browser_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="36dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tv_browser_path"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:text="Path: /Music"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_browser_title_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/container_browser_items"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:clipChildren="false"
                    android:clipToPadding="false" />
            </ScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/frame_browser_cover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <com.themoon.y1.views.RoundedImageView
                android:id="@+id/iv_browser_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/default_album" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_settings_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SETTINGS" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:layout_marginBottom="6dp"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/container_settings_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bluetooth_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BLUETOOTH SCAN" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <Button android:id="@+id/btn_scan_bt" android:layout_width="match_parent" android:layout_height="40dp" android:text="🔍 Scan Devices" android:textColor="#FFFFFF" android:textSize="16sp" android:background="#15FFFFFF" android:focusable="true"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_marginTop="5dp">
            <LinearLayout android:id="@+id/container_bt_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_wifi_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="WI-FI NETWORKS" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:layout_marginBottom="6dp"/>
        <Button android:id="@+id/btn_scan_wifi" android:layout_width="match_parent" android:layout_height="40dp" android:text="🔍 Scan Networks" android:textColor="#FFFFFF" android:textSize="16sp" android:background="#15FFFFFF" android:focusable="true"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:layout_marginTop="5dp">
            <LinearLayout android:id="@+id/container_wifi_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_wifi_keyboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="36dp"
        android:padding="15dp"
        android:background="#DD000000"
        android:visibility="gone">
        <TextView android:id="@+id/tv_keyboard_ssid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Target: My_Home_Wifi" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_keyboard_input" android:layout_width="match_parent" android:layout_height="40dp" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="#222222" android:layout_marginTop="10dp" android:layout_marginBottom="15dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/tv_key_pprev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="a" android:textColor="#555555" android:textSize="14sp" android:layout_marginRight="12dp"/>
            <TextView android:id="@+id/tv_key_prev" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="b" android:textColor="#AAAAAA" android:textSize="20sp" android:layout_marginRight="12dp"/>
            <TextView android:id="@+id/tv_key_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="c" android:textColor="#FFFFFF" android:textSize="36sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_key_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="d" android:textColor="#AAAAAA" android:textSize="20sp" android:layout_marginLeft="12dp"/>
            <TextView android:id="@+id/tv_key_nnext" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="e" android:textColor="#555555" android:textSize="14sp" android:layout_marginLeft="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Викторина: фон ink и два плоских вью. Экраны рисует QuizView в абсолютных координатах макетов
         (480x360), шкала отрывка накладывается поверх на y=92 и видна только в раунде. -->
    <FrameLayout
        android:id="@+id/layout_music_quiz_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF181E26"
        android:visibility="gone">
        <com.themoon.y1.views.QuizView android:id="@+id/quiz_view" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.themoon.y1.views.QuizSnippetBar android:id="@+id/quiz_snippet_bar" android:layout_width="448dp" android:layout_height="10dp" android:layout_marginLeft="16dp" android:layout_marginTop="92dp" android:visibility="gone"/>
    </FrameLayout>

    <!-- Читалка: фон ink и два плоских вью, показывается одно из них. Библиотеку и экран чтения рисуют
         BookListView и RsvpView в абсолютных координатах макетов (480x360). -->
    <FrameLayout
        android:id="@+id/layout_reader_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF181E26"
        android:visibility="gone">
        <com.themoon.y1.views.BookListView android:id="@+id/reader_book_list" android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.themoon.y1.views.RsvpView android:id="@+id/reader_rsvp" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/layout_player_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFFFF"
        android:visibility="gone">
        <!-- Держатель плашек качества звука (их добавляет код); в плоской и классической теме они скрыты. -->
        <RelativeLayout android:id="@+id/layout_player_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:paddingTop="6dp" android:paddingLeft="15dp" android:paddingRight="15dp"/>

        <!-- Геометрию для плоской темы (сетка 66 px) задаёт PlayerSkin; здесь классическая раскладка iPod. -->
        <LinearLayout android:id="@+id/layout_player_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingTop="16dp" android:paddingBottom="46dp" android:paddingLeft="14dp" android:paddingRight="14dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="top">
                <LinearLayout android:id="@+id/layout_player_cover_column" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginRight="14dp" android:layout_marginTop="10dp">
                    <FrameLayout android:id="@+id/frame_album_art" android:layout_width="220dp" android:layout_height="220dp">
                        <com.themoon.y1.views.SquareImageView android:id="@+id/iv_album_art" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/default_album" android:background="#DDDDDD" />
                        <!-- Затемнение обложки на паузе (плоская тема): отдельный слой, а не setAlpha всей картинки. -->
                        <View android:id="@+id/view_cover_dim" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
                        <ImageView android:id="@+id/iv_pause_overlay" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_pause" android:visibility="gone" />
                        <!-- Центр сердца в 34 px от левого и нижнего края обложки: 17 отступа + половина 34. -->
                        <ImageView android:id="@+id/iv_cover_like" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="bottom|left" android:layout_marginLeft="17dp" android:layout_marginBottom="17dp" android:visibility="gone" />
                    </FrameLayout>
                    <!-- 🚀 [신규 추가] 아래로 살짝 비치는 반사 효과 (iPod 스타일) -->
                    <FrameLayout android:id="@+id/frame_album_reflection" android:layout_width="220dp" android:layout_height="32dp" android:layout_marginTop="1dp">
                        <ImageView android:id="@+id/iv_album_reflection" android:layout_width="220dp" android:layout_height="220dp" android:layout_gravity="top" android:scaleY="-1" android:scaleType="centerCrop" android:alpha="0.30" android:src="@drawable/default_album" />
                        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/reflection_fade_gradient" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/layout_player_text_column" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="28dp">
                    <com.themoon.y1.views.MarqueeTextView android:id="@+id/tv_player_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Title" android:textColor="#000000" android:textSize="19sp" android:textStyle="bold" android:gravity="left" android:singleLine="true" android:ellipsize="marquee" android:marqueeRepeatLimit="marquee_forever" android:scrollHorizontally="true" android:focusable="true" android:focusableInTouchMode="true" />
                    <TextView android:id="@+id/tv_player_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Artist" android:textColor="#3C3C43" android:textSize="15sp" android:gravity="left" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" />
                    <TextView android:id="@+id/tv_player_album" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Album" android:textColor="#3C3C43" android:textSize="15sp" android:gravity="left" android:layout_marginTop="4dp" android:singleLine="true" android:ellipsize="end" />
                    <!-- Сердце «в избранном» классических тем стоит в строке счётчика: в правом верхнем углу его перекрывала строка состояния -->
                    <LinearLayout android:id="@+id/row_player_track_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/tv_player_track_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1 of 1" android:textColor="#8E8E93" android:textSize="15sp" android:textStyle="bold" android:gravity="left"/>
                        <ImageView android:id="@+id/iv_player_favorite" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginRight="2dp"/>
                    </LinearLayout>
                    <!-- Плоская тема: спектр занимает остаток колонки до нижнего края обложки (высоту колонки
                         PlayerSkin выставляет равной обложке); в классических темах вид скрыт. -->
                    <com.themoon.y1.views.AudioVisualizerView android:id="@+id/view_flat_spectrum" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
                    <!-- Строка текста песни на месте спектра (тот же слот weight=1): виден, пока у трека есть синхронный текст. -->
                    <com.themoon.y1.views.LyricsView android:id="@+id/view_lyrics_snippet" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Текст песни на весь экран (плоская тема): поверх содержимого плеера, под полосой прогресса. -->
        <com.themoon.y1.views.LyricsView android:id="@+id/view_lyrics_full" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />

        <!-- 🚀 [수정] 진행바를 화면 맨 아래로, 좌우 여백을 줘서 조금 짧게, 더 두껍게. 시간 글씨는 굵고 크게! -->
        <LinearLayout android:id="@+id/row_player_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingBottom="14dp">
            <TextView android:id="@+id/tv_player_time_current" android:layout_width="wrap_content" android:minWidth="62dp" android:layout_height="wrap_content" android:singleLine="true" android:text="0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="15sp" android:layout_marginRight="8dp"/>
            <ProgressBar android:id="@+id/player_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:max="100" android:progress="0"/>
            <TextView android:id="@+id/tv_player_time_total" android:layout_width="wrap_content" android:minWidth="62dp" android:layout_height="wrap_content" android:singleLine="true" android:gravity="right" android:text="-0:00" android:textColor="#000000" android:textStyle="bold" android:textSize="15sp" android:layout_marginLeft="8dp"/>
        </LinearLayout>

        <!-- 🚀 [iPod 스타일] 볼륨 조절 시 Progress 바와 똑같은 모양으로 일시적으로 겹쳐 보여주는 인라인 볼륨 게이지 -->
        <LinearLayout android:id="@+id/row_player_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="26dp" android:paddingRight="26dp" android:paddingBottom="14dp" android:visibility="gone">
            <ImageView android:id="@+id/iv_player_volume_low" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginRight="10dp"/>
            <ProgressBar android:id="@+id/player_volume_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:max="100" android:progress="0"/>
            <ImageView android:id="@+id/iv_player_volume_high" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginLeft="10dp"/>
        </LinearLayout>

        <!-- Низ плоского плеера: полоса x 16..464 с центром на y 300 (вид 62 px, полоса прижата к его низу,
             сверху место под пузырь перемотки), под ней строка времени с центром около y 322. -->
        <LinearLayout android:id="@+id/layout_player_flat_bottom" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:layout_marginTop="253dp" android:orientation="vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:visibility="gone">
            <com.themoon.y1.views.PlayerProgressView android:id="@+id/pv_player_progress" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <RelativeLayout android:id="@+id/row_player_flat_times" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:id="@+id/tv_flat_time_elapsed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:includeFontPadding="false" android:singleLine="true" android:text="00:00" android:textColor="#EFEBE2" android:textSize="14sp"/>
                <TextView android:id="@+id/tv_flat_track_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:layout_alignBaseline="@id/tv_flat_time_elapsed" android:includeFontPadding="false" android:singleLine="true" android:text="1 / 1" android:textColor="#A4A3A0" android:textSize="13sp"/>
                <TextView android:id="@+id/tv_flat_time_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:includeFontPadding="false" android:singleLine="true" android:text="-00:00" android:textColor="#A4A3A0" android:textSize="14sp"/>
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>

    <RelativeLayout
        android:id="@+id/layout_status_bar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:background="#00000000">

        <TextView
            android:id="@+id/tv_status_clock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/layout_status_right_group"
            android:layout_centerVertical="true"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="12:00 AM"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <LinearLayout
            android:id="@+id/layout_status_right_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/iv_status_headphone" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_headphone" android:visibility="gone" android:layout_marginRight="6dp"/>
            <ImageView android:id="@+id/iv_status_wifi" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_wifi" android:visibility="gone" android:layout_marginRight="6dp"/>
            <ImageView android:id="@+id/iv_status_bluetooth" android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_bluetooth" android:visibility="gone" android:layout_marginRight="8dp"/>
            <TextView android:id="@+id/tv_status_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="2"/>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/layout_volume_overlay"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView android:id="@+id/iv_volume_overlay_low" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginRight="10dp"/>
        <ProgressBar android:id="@+id/volume_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="15dp" android:max="15" android:progress="10"/>
        <ImageView android:id="@+id/iv_volume_overlay_high" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginLeft="10dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_brightness_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:paddingTop="36dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISPLAY BRIGHTNESS" android:textColor="#BBFFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>
        <ProgressBar android:id="@+id/pb_brightness" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="20dp" android:max="255" android:layout_marginBottom="15dp"/>
        <TextView android:id="@+id/tv_brightness_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100%" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_storage_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp"
        android:paddingTop="36dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ABOUT" android:textColor="#BBFFFFFF" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="30dp"/>
        <ProgressBar android:id="@+id/pb_storage" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="20dp" android:layout_marginBottom="15dp"/>
        <TextView android:id="@+id/tv_storage_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Used: 0MB / Total: 0MB" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Press [Back] to return." android:textColor="#888888" android:textSize="14sp" android:layout_marginTop="30dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_webserver_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="34dp"
        android:paddingBottom="8dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center_horizontal">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/iv_web_banner" android:layout_width="match_parent" android:layout_height="158dp" android:scaleType="fitXY" android:src="@drawable/web_banner_stopped"/>
            <LinearLayout android:layout_width="188dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="26dp" android:layout_marginTop="22dp">
                <TextView android:id="@+id/tv_web_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIRELESS PC UPLOAD" android:textColor="#BBFFFFFF" android:textSize="20sp" android:textStyle="bold" android:singleLine="true" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_server_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SERVER STOPPED" android:textColor="#FF5555" android:textSize="13sp" android:textStyle="bold" android:maxLines="3"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/tv_server_ip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="http://---.---.---.---:8080" android:textColor="#888888" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:layout_marginTop="12dp" android:layout_marginBottom="8dp"/>
        <Button android:id="@+id/btn_server_toggle" android:layout_width="320dp" android:layout_height="wrap_content" android:text="START SERVER" android:textSize="16sp" android:textColor="#FFFFFF" android:background="#00000000" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_marginBottom="8dp" android:focusable="true" android:defaultFocusHighlightEnabled="false"/>
        <TextView android:id="@+id/tv_server_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Enter the above address in your PC browser.\nPress [Back] to return." android:textColor="#888888" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_usb_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="34dp"
        android:paddingBottom="8dp"
        android:background="#66000000"
        android:visibility="gone"
        android:gravity="center_horizontal">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <ImageView android:id="@+id/iv_usb_banner" android:layout_width="match_parent" android:layout_height="158dp" android:scaleType="fitXY" android:src="@drawable/usb_banner_idle"/>
            <LinearLayout android:layout_width="188dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="26dp" android:layout_marginTop="22dp">
                <TextView android:id="@+id/tv_usb_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="USB" android:textColor="#BBFFFFFF" android:textSize="20sp" android:textStyle="bold" android:singleLine="true" android:layout_marginBottom="8dp"/>
                <TextView android:id="@+id/tv_usb_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CONNECTED TO COMPUTER" android:textColor="#FF5555" android:textSize="13sp" android:textStyle="bold" android:maxLines="3"/>
            </LinearLayout>
        </FrameLayout>
        <TextView android:id="@+id/tv_usb_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#888888" android:textSize="13sp" android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="10dp"/>
        <Button android:id="@+id/btn_usb_toggle" android:layout_width="320dp" android:layout_height="wrap_content" android:text="TURN ON USB STORAGE" android:textSize="16sp" android:textColor="#FFFFFF" android:background="#00000000" android:paddingTop="10dp" android:paddingBottom="10dp" android:layout_marginBottom="8dp" android:focusable="true" android:defaultFocusHighlightEnabled="false"/>
        <TextView android:id="@+id/tv_usb_footer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#888888" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_videos_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:background="#66000000"
        android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VIDEOS" android:textColor="#BBFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:layout_marginBottom="6dp"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:id="@+id/container_video_items" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 🚀 [신규 추가] 비디오 재생 화면: ExoPlayer가 그리는 SurfaceView 위에 최소한의 정보만 오버레이 -->
    <FrameLayout
        android:id="@+id/layout_video_player_mode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:visibility="gone">

        <SurfaceView android:id="@+id/surface_video" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" />

        <TextView android:id="@+id/tv_video_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:padding="14dp" android:text="Video" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingBottom="14dp">
            <TextView android:id="@+id/tv_video_time_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0:00" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_marginRight="10dp" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>
            <ProgressBar android:id="@+id/video_progress" style="?android:attr/progressBarStyleHorizontal" android:progressDrawable="@drawable/progress_bar_now_playing" android:layout_width="0dp" android:layout_height="20dp" android:layout_weight="1" android:max="100" android:progress="0"/>
            <TextView android:id="@+id/tv_video_time_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-0:00" android:textColor="#FFFFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_marginLeft="10dp" android:shadowColor="#FF000000" android:shadowDx="1" android:shadowDy="1" android:shadowRadius="3"/>
        </LinearLayout>

        <!-- 🚀 [탐색 모드 안내] 길게 눌러서 볼륨/탐색 모드를 전환했을 때 잠깐 보여주는 라벨 -->
        <TextView android:id="@+id/tv_video_mode_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Seek Mode" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold" android:background="#AA000000" android:padding="14dp" android:visibility="gone"/>
    </FrameLayout>
</FrameLayout>